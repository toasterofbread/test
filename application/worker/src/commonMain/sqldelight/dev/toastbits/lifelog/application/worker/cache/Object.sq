CREATE TABLE Object (
    repository TEXT NOT NULL,
    hash TEXT NOT NULL,
    type INTEGER NOT NULL,
    data_base64 TEXT NOT NULL,

    PRIMARY KEY (repository, hash)
);

set:
INSERT OR REPLACE INTO Object(repository, hash, type, data_base64) VALUES (?, ?, ?, ?);

get:
SELECT data_base64, type FROM Object WHERE repository = ? AND hash = ?;

getType:
SELECT type FROM Object WHERE repository = ? AND hash = ?;

getMultiple:
SELECT hash, type, data_base64 FROM Object WHERE repository = ? AND hash IN ?;

list:
SELECT hash, type FROM Object WHERE repository = ? AND type IN ?;

listHashes:
SELECT hash FROM Object WHERE repository = ? AND hash IN ?;

remove:
DELETE FROM Object WHERE repository = ? AND hash = ?;
